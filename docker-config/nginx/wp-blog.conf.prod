server {
    listen 80;
    server_name yu-syumilog.com www.yu-syumilog.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name yu-syumilog.com www.yu-syumilog.com;

    ssl_certificate /etc/letsencrypt/live/yu-syumilog.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yu-syumilog.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    error_page 503 /maintenance.html;

    location = /maintenance.html {
        root /usr/share/nginx/html;
        internal;
    }

    location / {
        return 503;
    }
}